{
  "name": "chess",
  "version": "1.0.0",
  "description": "Web-based multiplayer chess",
  "scripts": {
    "start": "node scripts/serve.js",
    "dev:worker": "wrangler dev --var ALLOW_LOCALHOST:true",
    "test": "node --test test/*.test.js",
    "build:worker": "wrangler deploy --dry-run --minify --outdir dist",
    "deploy:worker": "wrangler deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Loopback-Games/chess.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Loopback-Games/chess/issues"
  },
  "homepage": "https://github.com/Loopback-Games/chess#readme",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "chess.js": "^1.4.0",
    "wrangler": "^4.168.0"
  },
  "private": true
}
